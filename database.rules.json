{
  "rules": {
    ".read": true,
    ".write": true,
    "weatherStation": {
      "logs": {
        ".indexOn": ["lastUpdate"]
      }
    },
    "user_sessions": {
      ".indexOn": ["loginTime", "uid", "status"]
    },
    "activity_logs": {
      ".indexOn": ["timestamp", "uid"]
    },
    "otp_verifications": {
      ".indexOn": ["expiresAt", "email", "purpose"]
    }
  }
}
